---
interface Props { current?: 'estudio' | 'proyectos' | 'servicios'; locale?: string; alternatePath?: string; alternates?: Record<string,string> }
const { current, locale = 'es', alternatePath = '', alternates } = Astro.props;
const prefixes: Record<string, string> = { es: '', en: '/en', fr: '/fr', it: '/it', de:'/de', pt:'/pt' };
const base = prefixes[locale] ?? '';
const labels: Record<string, string[]> = {
  es: ['Estudio', 'Proyectos', 'Servicios', 'Hablemos', 'Abrir menú', 'Contacto', 'FAQ'],
  en: ['Studio', 'Projects', 'Services', 'Let’s talk', 'Open menu', 'Contact', 'FAQ'],
  fr: ['Studio', 'Projets', 'Services', 'Parlons-nous', 'Ouvrir le menu', 'Contact', 'FAQ'],
  it: ['Studio', 'Progetti', 'Servizi', 'Parliamo', 'Apri il menu', 'Contatti', 'FAQ'],
  de: ['Studio', 'Projekte', 'Leistungen', 'Sprechen wir', 'Menü öffnen', 'Kontakt', 'FAQ'],
  pt: ['Estúdio', 'Projetos', 'Serviços', 'Vamos conversar', 'Abrir menu', 'Contacto', 'FAQ'],
};
const l = labels[locale] ?? labels.es;
---
<header class="site-header">
  <a class="brand" href={`${base}/#inicio`} aria-label="Raquel Hedo, inicio">
    <span class="brand-mark">RH</span>
    <span class="brand-copy"><strong>RAQUEL HEDO</strong><small>ARCHITECTURE & INTERIORS</small></span>
  </a>
  <button class="menu-button" type="button" aria-label={l[4]} aria-expanded="false" data-menu-button><span></span><span></span></button>
  <nav class="site-nav" aria-label="Navegación principal" data-menu>
    <a class:list={{ active: current === 'estudio' }} href={`${base}/#estudio`}>{l[0]}</a>
    <a class:list={{ active: current === 'proyectos' }} href={`${base}/#proyectos`}>{l[1]}</a>
    <a class:list={{ active: current === 'servicios' }} href={`${base}/#servicios`}>{l[2]}</a>
    <a href={`${base}/#contacto`}>{l[5]}</a>
    <a href={`${base}/#faq`}>{l[6]}</a>
    <div class="language-switcher" aria-label="Language"><button type="button">{locale.toUpperCase()}⌄</button><div>{Object.entries(prefixes).map(([code, prefix]) => <a class:list={{ active: code === locale }} href={alternates?.[code] ?? `${prefix}${alternatePath}`}>{code.toUpperCase()}</a>)}</div></div>
    <a class="nav-contact" href={`${base}/#contacto`}>{l[3]} <span>↗</span></a>
  </nav>
</header>
