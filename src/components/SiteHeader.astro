---
interface Props { current?: 'estudio' | 'proyectos' | 'servicios' }
const { current } = Astro.props;
---
<header class="site-header">
  <a class="brand" href="/#inicio" aria-label="Raquel Hedo, inicio">
    <span class="brand-mark">RH</span>
    <span class="brand-copy"><strong>RAQUEL HEDO</strong><small>ARCHITECTURE & INTERIORS</small></span>
  </a>
  <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-button><span></span><span></span></button>
  <nav class="site-nav" aria-label="Navegación principal" data-menu>
    <a class:list={{ active: current === 'estudio' }} href="/#estudio">Estudio</a>
    <a class:list={{ active: current === 'proyectos' }} href="/#proyectos">Proyectos</a>
    <a class:list={{ active: current === 'servicios' }} href="/#servicios">Servicios</a>
    <a class="nav-contact" href="/#contacto">Hablemos <span>↗</span></a>
  </nav>
</header>
