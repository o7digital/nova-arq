---
import Layout from '../layouts/Layout.astro';
import ProjectGallery from '../components/ProjectGallery';

const services = [
  {
    number: '01',
    title: 'Arquitectura residencial',
    text: 'Obra nueva, ampliaciones y espacios concebidos desde la forma de vivir de cada cliente.',
  },
  {
    number: '02',
    title: 'Interiorismo & decoración',
    text: 'Concepto, materiales, color, iluminación y piezas que convierten una casa en un lugar propio.',
  },
  {
    number: '03',
    title: 'Remodelación integral',
    text: 'Una visión completa para rediseñar, coordinar y ejecutar cada transformación con precisión.',
  },
  {
    number: '04',
    title: 'Dirección & detalle',
    text: 'Supervisión de obra, presupuesto, proveedores, mobiliario a medida y control de calidad.',
  },
];

const steps = [
  { number: 'I', title: 'Escuchar', text: 'Entender la vida, las necesidades y la ambición detrás de cada espacio.' },
  { number: 'II', title: 'Imaginar', text: 'Traducir esa historia en concepto, atmósfera, función, materia y luz.' },
  { number: 'III', title: 'Precisar', text: 'Resolver planos, costos, proveedores, tiempos y cada decisión técnica.' },
  { number: 'IV', title: 'Materializar', text: 'Dirigir la ejecución y cuidar el proyecto hasta el último detalle.' },
];
---

<Layout
  title="Raquel Hedo | Arquitectura & Interiorismo"
  description="Raquel Hedo crea proyectos de arquitectura residencial, interiorismo, decoración y remodelación integral con una visión personal, técnica y atemporal."
>
  <header class="site-header">
    <a class="brand" href="#inicio" aria-label="Raquel Hedo, inicio">
      <span class="brand-mark">RH</span>
      <span class="brand-copy"><strong>RAQUEL HEDO</strong><small>ARCHITECTURE & INTERIORS</small></span>
    </a>
    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-button>
      <span></span><span></span>
    </button>
    <nav class="site-nav" aria-label="Navegación principal" data-menu>
      <a href="#estudio">Estudio</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#servicios">Servicios</a>
      <a class="nav-contact" href="#contacto">Hablemos <span>↗</span></a>
    </nav>
  </header>

  <main>
    <section class="hero" id="inicio">
      <div class="hero-image" data-hero-slider aria-label="Selección de proyectos de Raquel Hedo">
        <img class="hero-slide is-active" src="/assets/raquel-projects/hero-living-room.jpg" alt="Sala residencial de doble altura" fetchpriority="high" />
        <img class="hero-slide" src="/assets/raquel-projects/hero-exterior.jpg" alt="Arquitectura residencial integrada al paisaje" />
        <img class="hero-slide" src="/assets/raquel-projects/hero-open-plan.jpg" alt="Área social abierta con comedor, sala y cocina" />
        <img class="hero-slide" src="/assets/raquel-projects/hero-bathroom.jpg" alt="Baño residencial con materiales naturales" />
      </div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="eyebrow hero-eyebrow"><span></span> Arquitectura · Interiorismo · Decoración</p>
        <h1>Espacios que<br />cuentan <em>quién eres.</em></h1>
        <p class="hero-intro">Arquitectura e interiores pensados como una sola experiencia: personal, precisa y profundamente humana.</p>
        <div class="hero-actions">
          <a class="button button--light" href="#proyectos">Descubrir el trabajo <span>→</span></a>
          <a class="text-link text-link--light" href="#estudio">Conocer a Raquel <span>↗</span></a>
        </div>
      </div>
      <div class="hero-signature">
        <span>Desde 2001</span>
        <span>Architecture & Interiors</span>
      </div>
      <div class="hero-slider-controls" aria-label="Controles del slider">
        <button type="button" data-slider-previous aria-label="Imagen anterior">←</button>
        <div class="hero-slider-dots" role="group" aria-label="Elegir imagen">
          <button class="is-active" type="button" data-slider-dot="0" aria-label="Mostrar imagen 1" aria-pressed="true"></button>
          <button type="button" data-slider-dot="1" aria-label="Mostrar imagen 2" aria-pressed="false"></button>
          <button type="button" data-slider-dot="2" aria-label="Mostrar imagen 3" aria-pressed="false"></button>
          <button type="button" data-slider-dot="3" aria-label="Mostrar imagen 4" aria-pressed="false"></button>
        </div>
        <button type="button" data-slider-next aria-label="Imagen siguiente">→</button>
      </div>
      <a class="scroll-cue" href="#estudio" aria-label="Ir a la siguiente sección"><span>Scroll</span><b>↓</b></a>
    </section>

    <section class="manifesto section-pad" id="estudio">
      <div class="manifesto-index" aria-hidden="true">01 / 05</div>
      <div class="manifesto-copy" data-reveal>
        <p class="eyebrow"><span></span> Una visión integral</p>
        <h2>La arquitectura no termina en los muros.</h2>
        <div class="manifesto-columns">
          <p class="lead">Empieza en cómo entra la luz, cómo fluye una conversación y cómo cada objeto encuentra su lugar.</p>
          <p>Raquel Hedo concibe arquitectura, interiorismo y decoración como una sola disciplina. Desde la primera idea hasta la entrega, combina sensibilidad estética, dominio técnico y dirección de obra para crear espacios irrepetibles.</p>
        </div>
      </div>
    </section>

    <section class="portfolio section-pad" id="proyectos">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow"><span></span> Selección de atmósferas</p>
          <h2>Obra & espacios</h2>
        </div>
        <p>Una muestra editorial del lenguaje visual. Las imágenes serán sustituidas por el portafolio real de Raquel.</p>
      </div>
      <ProjectGallery client:load />
    </section>

    <section class="quote-section">
      <div class="quote-image" aria-hidden="true"></div>
      <div class="quote-overlay" aria-hidden="true"></div>
      <div class="quote-content" data-reveal>
        <p>Arquitectura e interiorismo concebidos como una experiencia integral.</p>
        <span>Del espacio a la luz · Del mobiliario al detalle</span>
      </div>
    </section>

    <section class="services section-pad" id="servicios">
      <div class="section-heading section-heading--dark" data-reveal>
        <div>
          <p class="eyebrow"><span></span> El estudio</p>
          <h2>Una visión.<br /><em>Cuatro disciplinas.</em></h2>
        </div>
        <p>Un solo punto de contacto para imaginar, definir y materializar un proyecto completo.</p>
      </div>
      <div class="service-list">
        {services.map((service) => (
          <article class="service-row" data-reveal>
            <span>{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <b aria-hidden="true">↗</b>
          </article>
        ))}
      </div>
    </section>

    <section class="process section-pad">
      <div class="process-top" data-reveal>
        <p class="eyebrow"><span></span> El proceso</p>
        <h2>Del primer trazo<br />al último detalle.</h2>
        <p>Una metodología rigurosa, cercana y transparente para que el proceso se disfrute tanto como el resultado.</p>
      </div>
      <div class="process-grid">
        {steps.map((step) => (
          <article data-reveal>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="profile section-pad">
      <div class="profile-visual" data-reveal>
        <div class="portrait-frame">
          <img src="/assets/portrait/raquel-hedo-reference.png" alt="Retrato provisional de Raquel Hedo" loading="lazy" />
        </div>
        <div class="profile-years"><strong>≈25</strong><span>años creando<br />espacios con identidad</span></div>
      </div>
      <div class="profile-copy" data-reveal>
        <p class="eyebrow"><span></span> Raquel Hedo</p>
        <h2>Una mirada formada entre arquitectura, arte y mundo.</h2>
        <p class="profile-lead">Arquitecta y decoradora independiente desde 2001, especializada en arquitectura residencial, construcción nueva y remodelación.</p>
        <p>Formada en Arquitectura en la Universidad Anáhuac, amplió sus estudios en Boston, Harvard, Pittsburgh, Florencia y Suiza, y cursó un MBA. Su práctica integra diseño, presupuestos, proveedores, contratistas, mobiliario a medida e iluminación.</p>
        <div class="credentials">
          <div><strong>4</strong><span>Idiomas<br />ES · EN · FR · IT</span></div>
          <div><strong>360°</strong><span>Diseño, presupuesto<br />y ejecución</span></div>
          <div><strong>2001</strong><span>Práctica independiente<br />en México</span></div>
        </div>
      </div>
    </section>

    <section class="worldline">
      <p>UNIVERSIDAD ANÁHUAC</p><span>·</span><p>BOSTON</p><span>·</span><p>HARVARD</p><span>·</span><p>PITTSBURGH</p><span>·</span><p>FLORENCIA</p><span>·</span><p>SUIZA</p>
    </section>

    <section class="contact section-pad" id="contacto">
      <div class="contact-copy" data-reveal>
        <p class="eyebrow"><span></span> Conversemos</p>
        <h2>Tu próximo espacio empieza con una conversación.</h2>
        <p>Cuando estén disponibles los datos de contacto definitivos, este espacio permitirá iniciar una conversación sobre el proyecto.</p>
        <span class="button button--dark button--static">Iniciar un proyecto <span>↗</span></span>
      </div>
      <div class="contact-monogram" aria-hidden="true">RH</div>
    </section>
  </main>

  <footer>
    <a class="brand brand--footer" href="#inicio">
      <span class="brand-mark">RH</span>
      <span class="brand-copy"><strong>RAQUEL HEDO</strong><small>ARCHITECTURE & INTERIORS</small></span>
    </a>
    <p>Arquitectura residencial · Interiorismo · Decoración</p>
    <div><span>© 2026 RAQUEL HEDO</span><a href="#inicio">VOLVER ARRIBA ↑</a></div>
  </footer>
</Layout>
