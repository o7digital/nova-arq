---
import "../styles/global.css";

const projects = [
  {
    name: "Casa Bosques",
    category: "Remodelación residencial",
    location: "Bosques de las Lomas, CDMX",
    image:
      "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=88",
    size: "lg:col-span-7 lg:row-span-2",
  },
  {
    name: "Residencia Norte",
    category: "Casa nueva",
    location: "Interlomas, Estado de México",
    image:
      "https://images.unsplash.com/photo-1600607687644-aac4c3eac7f4?auto=format&fit=crop&w=1200&q=88",
    size: "lg:col-span-5",
  },
  {
    name: "Casa Lomas",
    category: "Interiorismo",
    location: "Lomas de Chapultepec, CDMX",
    image:
      "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1200&q=88",
    size: "lg:col-span-5",
  },
  {
    name: "Proyecto Valle",
    category: "Ampliación",
    location: "Valle de Bravo",
    image:
      "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=88",
    size: "lg:col-span-12",
  },
];

const services = [
  {
    number: "01",
    title: "Remodelación Integral",
    items: ["Cocinas", "Baños", "Fachadas", "Espacios sociales"],
  },
  {
    number: "02",
    title: "Planos Arquitectónicos",
    items: ["Planos ejecutivos", "Permisos", "Documentación técnica"],
  },
  {
    number: "03",
    title: "Diseño Residencial",
    items: ["Casas nuevas", "Ampliaciones", "Diseño personalizado"],
  },
];

const steps = ["Diagnóstico", "Concepto", "Planos", "Construcción", "Entrega"];

const seoDescription =
  "Despacho de arquitectura residencial en Ciudad de México especializado en remodelación de casas, planos arquitectónicos, interiorismo y diseño de casas modernas.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NOVA ARQ | Arquitecto residencial en Ciudad de México</title>
    <meta name="description" content={seoDescription} />
    <meta
      name="keywords"
      content="Arquitecto en Ciudad de México, Arquitecto residencial, Remodelación de casas, Diseño de casas modernas, Planos arquitectónicos, Despacho de arquitectura, Arquitectura residencial CDMX, Remodelación residencial, Diseño arquitectónico, Arquitecto para casas"
    />
    <meta property="og:title" content="NOVA ARQ | Arquitectura residencial premium" />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=1600&q=88" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="fixed left-0 top-0 z-50 w-full bg-gradient-to-b from-ink/95 via-ink/55 to-transparent px-5 py-5 md:px-[7vw] md:py-7">
      <div class="mx-auto flex max-w-[1680px] items-center justify-between">
        <a href="#" class="font-serif text-xl tracking-[0.18em] text-ivory md:text-2xl">NOVA · ARQ</a>
        <nav class="hidden items-center gap-8 text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-muted md:flex">
          <a class="transition hover:text-accent" href="#servicios">Servicios</a>
          <a class="transition hover:text-accent" href="#proyectos">Proyectos</a>
          <a class="transition hover:text-accent" href="#proceso">Proceso</a>
          <a class="transition hover:text-accent" href="#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="relative grid min-h-screen overflow-hidden px-5 pb-16 pt-28 md:px-[7vw] md:pt-32 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_28%,rgba(201,155,98,0.16),transparent_28%),linear-gradient(115deg,rgba(17,16,13,0.98)_0%,rgba(17,16,13,0.78)_48%,rgba(17,16,13,0.3)_100%)]"></div>
        <div class="reveal relative z-10 max-w-4xl">
          <p class="mb-7 text-[0.72rem] font-bold uppercase tracking-[0.22em] text-accent">
            Arquitectura residencial · Remodelación · Planos
          </p>
          <h1 class="editorial-title max-w-[46rem] text-[4.1rem] tracking-normal text-ivory md:text-[5.4rem] lg:text-[4.8rem] xl:text-[5.25rem] 2xl:text-[6.6rem]">
            Casas diseñadas para vivir mejor.
          </h1>
          <p class="mt-8 max-w-2xl text-lg leading-8 text-muted md:text-xl md:leading-9">
            Transformamos propiedades en espacios elegantes, funcionales y atemporales mediante arquitectura,
            remodelación y diseño residencial.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a class="btn-premium btn-primary" href="#contacto">Agendar Consulta</a>
            <a class="btn-premium btn-secondary" href="#proyectos">Ver Proyectos</a>
          </div>
        </div>

        <div class="relative z-10 mt-12 lg:mt-0">
          <div class="group relative h-[64vh] min-h-[440px] overflow-hidden lg:h-[78vh]" data-parallax>
            <img
              class="h-[112%] w-full object-cover object-center transition duration-[1400ms] ease-out group-hover:scale-[1.04]"
              src="https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=1500&q=88"
              alt="Casa contemporánea con arquitectura residencial premium"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/12 to-transparent"></div>
            <div class="absolute bottom-6 left-6 max-w-[18rem] border border-ivory/15 bg-ivory px-7 py-7 text-ink md:bottom-10">
              <strong class="block font-serif text-5xl font-normal leading-none md:text-6xl">150+</strong>
              <span class="mt-4 block text-sm leading-6 text-[#675843]">
                proyectos residenciales con precisión técnica, diseño contemporáneo y visión de inversión.
              </span>
            </div>
          </div>
        </div>
      </section>

      <section class="px-5 py-24 md:px-[7vw] md:py-32">
        <div class="reveal mx-auto grid max-w-[1500px] gap-12 border-t border-ivory/15 pt-16 lg:grid-cols-[0.72fr_1.28fr] lg:gap-24">
          <p class="text-[0.72rem] font-bold uppercase tracking-[0.22em] text-accent">Filosofía</p>
          <div>
            <h2 class="max-w-4xl font-serif text-5xl font-normal leading-[1.02] text-ivory md:text-7xl">
              Arquitectura que aumenta el valor de tu propiedad.
            </h2>
            <p class="mt-8 max-w-3xl text-lg leading-9 text-muted">
              Diseñamos con una lectura clara del estilo de vida, la inversión y la ejecución. Cada decisión busca
              elevar la funcionalidad, mejorar la calidad de vida y construir una propiedad más sólida, deseable y
              atemporal.
            </p>
          </div>
        </div>
      </section>

      <section id="servicios" class="px-5 pb-24 md:px-[7vw] md:pb-32">
        <div class="mx-auto max-w-[1500px]">
          <div class="reveal grid border border-ivory/15 lg:grid-cols-3">
            {services.map((service) => (
              <article class="group min-h-[22rem] border-b border-ivory/15 p-8 transition duration-300 hover:bg-ivory hover:text-ink lg:border-b-0 lg:border-r lg:border-ivory/15 lg:p-11">
                <span class="text-[0.72rem] font-bold uppercase tracking-[0.18em] text-accent">{service.number}</span>
                <h3 class="mt-8 font-serif text-4xl font-normal leading-tight">{service.title}</h3>
                <ul class="mt-8 space-y-3 text-muted group-hover:text-[#5E5140]">
                  {service.items.map((item) => <li>{item}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="proyectos" class="bg-paper px-5 py-24 text-ink md:px-[7vw] md:py-32">
        <div class="mx-auto max-w-[1500px]">
          <div class="reveal mb-14 flex flex-col justify-between gap-8 md:flex-row md:items-end">
            <h2 class="max-w-3xl font-serif text-6xl font-normal leading-none md:text-8xl">Portfolio Premium</h2>
            <p class="max-w-md text-base leading-8 text-[#5f5446]">
              Remodelación residencial, casas nuevas, ampliaciones e interiorismo con lenguaje arquitectónico propio.
            </p>
          </div>

          <div class="grid auto-rows-[20rem] grid-cols-1 gap-5 lg:grid-cols-12 lg:auto-rows-[18rem]">
            {projects.map((project) => (
              <article class={`reveal group relative overflow-hidden ${project.size}`}>
                <img
                  class="h-full w-full object-cover transition duration-[900ms] ease-out group-hover:scale-[1.055]"
                  src={project.image}
                  alt={`${project.name}, ${project.category} en ${project.location}`}
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-6 text-ivory md:p-9">
                  <p class="text-[0.7rem] font-bold uppercase tracking-[0.16em] text-accent">{project.category}</p>
                  <h3 class="mt-2 font-serif text-4xl font-normal">{project.name}</h3>
                  <p class="mt-2 text-sm text-muted">{project.location}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="proceso" class="px-5 py-24 md:px-[7vw] md:py-32">
        <div class="reveal mx-auto grid max-w-[1500px] gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
          <div>
            <p class="text-[0.72rem] font-bold uppercase tracking-[0.22em] text-accent">Proceso</p>
            <h2 class="mt-7 max-w-xl font-serif text-5xl font-normal leading-[1.02] md:text-7xl">
              De la primera idea al proyecto listo para habitar.
            </h2>
          </div>
          <div class="border-t border-ivory/15">
            {steps.map((step, index) => (
              <div class="grid grid-cols-[4.5rem_1fr] gap-5 border-b border-ivory/15 py-7 md:grid-cols-[7rem_1fr]">
                <span class="text-sm font-bold tracking-[0.18em] text-accent">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="text-2xl font-medium text-ivory">{step}</h3>
                  <p class="mt-3 max-w-2xl leading-7 text-muted">
                    {index === 0 && "Medimos, escuchamos objetivos y definimos alcance, presupuesto y prioridades."}
                    {index === 1 && "Construimos una visión estética y funcional con materiales, distribución y atmósfera."}
                    {index === 2 && "Desarrollamos planos ejecutivos, permisos y documentación técnica para construir."}
                    {index === 3 && "Coordinamos decisiones clave y supervisamos que la obra respete el diseño."}
                    {index === 4 && "Cerramos detalles, verificamos calidad y entregamos un espacio listo para disfrutarse."}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-[#171510] px-5 py-24 md:px-[7vw]">
        <div class="reveal mx-auto grid max-w-[1500px] gap-8 lg:grid-cols-2">
          <figure class="border-l border-accent pl-8">
            <div class="text-accent">★★★★★</div>
            <blockquote class="mt-6 max-w-2xl font-serif text-4xl leading-tight text-ivory">
              “Transformaron completamente nuestra casa y aumentaron su valor.”
            </blockquote>
            <figcaption class="mt-7 text-sm uppercase tracking-[0.16em] text-muted">
              Cliente Residencial · Ciudad de México
            </figcaption>
          </figure>
          <figure class="border-l border-ivory/15 pl-8">
            <div class="text-accent">★★★★★</div>
            <blockquote class="mt-6 max-w-2xl font-serif text-4xl leading-tight text-ivory">
              “El proceso fue claro, elegante y técnicamente impecable de inicio a entrega.”
            </blockquote>
            <figcaption class="mt-7 text-sm uppercase tracking-[0.16em] text-muted">
              Propietario · Lomas de Chapultepec
            </figcaption>
          </figure>
        </div>
      </section>

      <section id="contacto" class="relative overflow-hidden px-5 py-28 text-center md:px-[7vw] md:py-40">
        <img
          class="absolute inset-0 h-full w-full object-cover"
          src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=88"
          alt="Interior residencial premium para llamada a la acción"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-ink/78"></div>
        <div class="reveal relative z-10 mx-auto max-w-4xl">
          <h2 class="font-serif text-6xl font-normal leading-none text-ivory md:text-8xl">Hablemos de tu próximo proyecto.</h2>
          <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-muted">
            Agenda una consulta inicial y descubre cómo transformar tu propiedad con una propuesta arquitectónica premium.
          </p>
          <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a class="btn-premium btn-primary" href="mailto:hola@novaarq.mx?subject=Solicitud%20de%20cotización">Solicitar Cotización</a>
            <a class="btn-premium btn-secondary" href="https://wa.me/525500000000">WhatsApp</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="flex flex-col gap-3 px-5 py-8 text-sm text-[#8f8374] md:flex-row md:justify-between md:px-[7vw]">
      <span>© 2026 NOVA · ARQ</span>
      <span>Arquitectura residencial CDMX · Remodelación · Planos arquitectónicos</span>
    </footer>

    <script>
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!prefersReducedMotion) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );

        document.querySelectorAll(".reveal").forEach((element) => revealObserver.observe(element));

        const parallax = document.querySelector("[data-parallax] img");
        const updateParallax = () => {
          if (!(parallax instanceof HTMLElement)) return;
          const offset = window.scrollY * 0.08;
          parallax.style.transform = `translate3d(0, ${offset}px, 0) scale(1.02)`;
        };

        updateParallax();
        window.addEventListener("scroll", updateParallax, { passive: true });
      } else {
        document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
