---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProjectGallery from '../../components/ProjectGallery';
import ContactForm from '../../components/ContactForm.astro';
import FaqSection from '../../components/FaqSection.astro';
import { homeCopy, getLocalizedServices, localeConfig, type Locale } from '../../data/i18n';

export function getStaticPaths() { return Object.keys(localeConfig).map((lang) => ({ params:{ lang }, props:{ locale:lang } })); }
const locale = Astro.props.locale as Locale;
const t = homeCopy[locale];
const services = getLocalizedServices(locale);
const servicePath = localeConfig[locale].servicesPath;
---
<Layout title={t.title} description={t.description} lang={locale}>
  <div id="top"></div><SiteHeader locale={locale} alternatePath="/" />
  <main>
    <section class="hero" id="inicio">
      <div class="hero-image" data-hero-slider aria-label="Raquel Hedo projects">
        <img class="hero-slide is-active" src="/assets/raquel-projects/hero-dining.webp" alt="Double-height residential dining and living room" fetchpriority="high" />
        <img class="hero-slide" src="/assets/raquel-projects/hero-staircase.webp" alt="Residential staircase with glass balustrade" />
      </div><div class="hero-shade"></div><div class="hero-grid"></div>
      <div class="hero-content"><p class="eyebrow hero-eyebrow"><span></span>{t.heroEye}</p><h1>{t.heroTitle}<br/><em>{t.heroEm}</em></h1><p class="hero-intro">{t.heroIntro}</p><div class="hero-actions"><a class="button button--light" href="#proyectos">{t.discover}<span>→</span></a><a class="text-link text-link--light" href="#estudio">{t.know}<span>↗</span></a></div></div>
      <div class="hero-signature"><span>{t.since}</span><span>Architecture & Interiors</span></div>
      <div class="hero-slider-controls"><button type="button" data-slider-previous aria-label="Previous">←</button><div class="hero-slider-dots">{[0,1].map((n)=><button class:list={{'is-active':n===0}} type="button" data-slider-dot={n} aria-label={`Image ${n+1}`}></button>)}</div><button type="button" data-slider-next aria-label="Next">→</button></div>
    </section>
    <section class="manifesto section-pad" id="estudio"><div class="manifesto-index">01 / 05</div><div class="manifesto-copy" data-reveal><p class="eyebrow"><span></span>{t.visionEye}</p><h2>{t.visionTitle}</h2><div class="manifesto-columns"><p class="lead">{t.visionLead}</p><p>{t.visionText}</p></div></div></section>
    <section class="portfolio section-pad" id="proyectos"><div class="section-heading" data-reveal><div><p class="eyebrow"><span></span>{t.workEye}</p><h2>{t.workTitle}</h2></div><p>{t.workText}</p></div><ProjectGallery client:load locale={locale}/></section>
    <section class="quote-section"><div class="quote-image"></div><div class="quote-overlay"></div><div class="quote-content" data-reveal><p>{t.quote}</p><span>{t.quoteSub}</span></div></section>
    <section class="services section-pad" id="servicios"><div class="section-heading section-heading--dark" data-reveal><div><p class="eyebrow"><span></span>{t.serviceEye}</p><h2>{t.serviceTitle}<br/><em>{t.serviceEm}</em></h2></div><p>{t.serviceText}</p></div><div class="service-list">{services.map((service)=><a class="service-row" href={`/${locale}/${servicePath}/${service.slug}/`} data-reveal><span>{service.number}</span><div class="service-title"><h3>{service.title}</h3><small>{t.view}</small></div><p>{service.text}</p><b><i>{t.view}</i>↗</b></a>)}</div></section>
    <section class="process section-pad"><div class="process-top" data-reveal><p class="eyebrow"><span></span>{t.processEye}</p><h2>{t.processTitle}</h2><p>{t.processText}</p></div><div class="process-grid">{t.steps.map(([number,title,text])=><article data-reveal><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
    <section class="profile section-pad"><div class="profile-visual" data-reveal><div class="portrait-frame"><img src="/assets/portrait/raquel-hedo.webp" alt="Raquel Hedo" loading="lazy"/></div><div class="profile-years"><strong>≈25</strong><span>{t.years}</span></div></div><div class="profile-copy" data-reveal><p class="eyebrow"><span></span>{t.profileEye}</p><h2>{t.profileTitle}</h2><p class="profile-lead">{t.profileLead}</p><p>{t.profileText}</p><div class="credentials"><div><strong>4</strong><span>{t.languages}<br/>ES · EN · FR · IT</span></div><div><strong>360°</strong><span>Design, budget<br/>& execution</span></div><div><strong>2001</strong><span>{t.practice}</span></div></div></div></section>
    <section class="worldline"><p>UNIVERSIDAD ANÁHUAC</p><span>·</span><p>BOSTON</p><span>·</span><p>HARVARD</p><span>·</span><p>PITTSBURGH</p><span>·</span><p>FIRENZE</p><span>·</span><p>SUISSE</p></section><FaqSection locale={locale}/>
    <section class="contact section-pad" id="contacto"><div class="contact-copy" data-reveal><p class="eyebrow"><span></span>{t.conversation}</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p><ContactForm locale={locale}/></div><div class="contact-monogram">RH</div></section>
  </main><SiteFooter locale={locale}/>
</Layout>
